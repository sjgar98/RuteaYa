# Copiar a .env (ignorado por git). Solo necesario en Linux/macOS, donde no existe LocalDB.
# Si RUTEAYA_DB_HOST no está definida se usa LocalDB. PORT y NAME son opcionales (1433 y RuteaYa).
RUTEAYA_DB_HOST=localhost
RUTEAYA_DB_PORT=1433
RUTEAYA_DB_NAME=RuteaYa
RUTEAYA_DB_USER=sa
RUTEAYA_DB_PASSWORD=<password>
