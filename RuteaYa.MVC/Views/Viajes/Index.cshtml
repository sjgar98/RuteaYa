@model RuteaYa.MVC.Models.MisViajesViewModel
@{
    ViewData["Title"] = "Mis viajes";

    string ClaseFiltro(bool? filtro) => Model.Activo == filtro ? "btn-dark" : "btn-outline-secondary";
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1 class="h3 mb-0">Mis viajes</h1>
        <p class="text-muted small mb-0">Tus recorridos habituales.</p>
    </div>
    <a class="btn btn-dark btn-sm" asp-action="Nuevo">Nuevo viaje</a>
</div>

<nav class="d-flex gap-2 mb-3">
    <a class="btn btn-sm rounded-pill @ClaseFiltro(null)" asp-action="Index">Todos</a>
    <a class="btn btn-sm rounded-pill @ClaseFiltro(true)" asp-action="Index" asp-route-activo="true">Activos</a>
    <a class="btn btn-sm rounded-pill @ClaseFiltro(false)" asp-action="Index" asp-route-activo="false">Inactivos</a>
</nav>

<div class="card border-0 shadow-sm rounded-4">
    @if (Model.Viajes.Count == 0)
    {
        <div class="card-body text-center text-muted py-5">No tenés viajes para mostrar.</div>
    }
    else
    {
        <ul class="list-group list-group-flush rounded-4">
            @foreach (var viaje in Model.Viajes)
            {
                <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2 py-3">
                    <div>
                        <div class="fw-semibold">@viaje.OrigenDir → @viaje.DestinoDir</div>
                        <div class="text-muted small">
                            @string.Join(", ", viaje.Dias.Select(d => d.Abreviar())) ·
                            @viaje.HoraSalida.ToString("HH:mm") – @viaje.HoraLlegada.ToString("HH:mm")
                        </div>
                    </div>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        @if (viaje.Activo)
                        {
                            <span class="badge rounded-pill badge-activo">Activo</span>
                        }
                        else
                        {
                            <span class="badge rounded-pill text-bg-light border">Inactivo</span>
                        }
                        <a class="btn btn-outline-secondary btn-sm" asp-action="Detalle" asp-route-id="@viaje.Id">Ver detalle</a>
                        <a class="btn btn-outline-secondary btn-sm" asp-controller="Oportunidades" asp-action="Index" asp-route-viajeId="@viaje.Id">Oportunidades</a>
                        @if (viaje.Activo)
                        {
                            <form asp-action="Desactivar" asp-route-id="@viaje.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-secondary btn-sm">Desactivar</button>
                            </form>
                        }
                    </div>
                </li>
            }
        </ul>
    }
</div>
