@model RuteaYa.DTOs.RegistroUsuarioDto
@{
    ViewData["Title"] = "Crear cuenta";
    Layout = "_LayoutCuenta";
}

@* Las validaciones del cliente salen de las Data Annotations de RegistroUsuarioDto (jquery.validate.unobtrusive). *@
<form asp-action="Registro" method="post" class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4">
        <h1 class="h4 mb-3">Crear cuenta</h1>

        <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>

        <div class="row g-3 mb-3">
            <div class="col-sm-6">
                <label asp-for="Nombre" class="form-label small fw-semibold">Nombre</label>
                <input asp-for="Nombre" class="form-control" autocomplete="given-name" autofocus />
                <span asp-validation-for="Nombre" class="text-danger small"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="Apellido" class="form-label small fw-semibold">Apellido</label>
                <input asp-for="Apellido" class="form-control" autocomplete="family-name" />
                <span asp-validation-for="Apellido" class="text-danger small"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label small fw-semibold">Email</label>
            <input asp-for="Email" class="form-control" placeholder="nombre@ejemplo.com" autocomplete="email" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label small fw-semibold">Contraseña</label>
            <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" aria-describedby="ayuda-password" />
            <div id="ayuda-password" class="form-text">Mínimo 8 caracteres, con al menos una letra y un número.</div>
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label asp-for="ConfirmarPassword" class="form-label small fw-semibold">Confirmar contraseña</label>
            <input asp-for="ConfirmarPassword" type="password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmarPassword" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn btn-dark w-100">Crear cuenta</button>

        <p class="text-center text-muted small mt-3 mb-0">
            ¿Ya tenés cuenta? <a asp-action="Login">Iniciar sesión</a>
        </p>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
