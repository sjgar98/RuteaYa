@model RuteaYa.DTOs.HistorialDto
@{
    ViewData["Title"] = "Historial";
}

<div class="container-fluid px-4 py-4">
    <div class="mb-4">
        <h2 class="fw-bold text-dark">Historial</h2>
        <p class="text-muted">Operaciones anteriores y estadísticas efectivas.</p>
    </div>

   
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3">
                <span class="text-muted small">Viajes realizados</span>
                <h3 class="fw-bold mb-0 text-dark">@Model.ViajesRealizados</h3>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3">
                <span class="text-muted small">Envíos transportados</span>
                <h3 class="fw-bold mb-0 text-dark">@Model.EnviosTransportados</h3>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-light border-success">
                <span class="text-success small fw-semibold">Ganancia efectiva</span>
                <h3 class="fw-bold mb-0 text-success">@Model.GananciaEfectiva.Moneda()</h3>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-3 mb-4">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-2">
                <label class="form-label small text-muted">Desde</label>
                <input type="date" name="desde" value="@ViewBag.Desde" class="form-control rounded-3" />
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted">Hasta</label>
                <input type="date" name="hasta" value="@ViewBag.Hasta" class="form-control rounded-3" />
            </div>
            @* <div class="col-md-2">
                <label class="form-label small text-muted">Tipo / Estado</label>
                <select name="estado" class="form-select rounded-3">
                    <option value="" selected="@(string.IsNullOrEmpty(ViewBag.Estado))">Todos</option>
                    <option value="Viaje" selected="@(ViewBag.Estado == "Viaje")">Viajes</option>
                </select>
            </div> *@
            <div class="col-md-3">
                <label class="form-label small text-muted">Ordenar por</label>
                <select name="orden" class="form-select rounded-3">
                    <option value="fecha_desc" selected="@(ViewBag.Orden == "fecha_desc")">Más recientes primero</option>
                    <option value="fecha_asc" selected="@(ViewBag.Orden == "fecha_asc")">Más antiguos primero</option>
                    <option value="monto_desc" selected="@(ViewBag.Orden == "monto_desc")">Mayor monto</option>
                    <option value="monto_asc" selected="@(ViewBag.Orden == "monto_asc")">Menor monto</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-dark rounded-3 w-100">Filtrar</button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary rounded-3">Limpiar</a>
            </div>
        </form>
    </div>


    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            @if (Model.Items != null && Model.Items.Any())
            {
                <div class="list-group list-group-flush">
                    @foreach (var item in Model.Items)
                    {
                        <div class="list-group-item p-4 d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="fw-bold mb-1">@item.Descripcion</h6>
                                <p class="text-muted small mb-0">@item.Detalle &bull; <span class="text-secondary">@item.Fecha.ToString("dd/MM/yyyy")</span></p>
                            </div>
                            <div class="d-flex align-items-center gap-3">
                                @if (item.Monto > 0)
                                {
                                    <span class="fw-bold text-success fs-5">@item.Monto.Moneda()</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary rounded-pill">Viaje</span>
                                }
                                
                            
                                @if (item.Tipo == "Viaje")
                                {
                                    <a href="@Url.Action("Detalle", "Viajes", new { id = item.Id })" class="btn btn-sm btn-outline-secondary rounded-pill px-3">Ver detalle</a>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <p class="text-muted mb-0">No hay registros en el historial para los filtros seleccionados.</p>
                </div>
            }
        </div>
    </div>
</div>