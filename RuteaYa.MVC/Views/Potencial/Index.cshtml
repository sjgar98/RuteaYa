@model RuteaYa.DTOs.PotencialMensualDto
@{
    ViewData["Title"] = "Potencial de Ganancias Mensual";
    var mesActual = ViewData["MesActual"]?.ToString() ?? DateTime.UtcNow.ToString("yyyy-MM");
    var criterioActual = ViewData["CriterioActual"]?.ToString() ?? "ganancia";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h2 class="fw-bold mb-1 fs-3">Potencial de ganancias mensual</h2>
            <p class="text-muted mb-0 small">Estimación basada en tus viajes recurrentes y envíos disponibles actuales.</p>
        </div>
        
        <!-- Formulario de filtro con ID explícito para evitar conflictos -->
        <form method="get" asp-controller="Potencial" asp-action="Index" id="formFiltro" class="row g-2 align-items-center">
            <div class="col-auto">
                <input type="month" id="mes" name="mes" value="@mesActual" class="form-control form-control-sm" onchange="document.getElementById('formFiltro').submit()" />
            </div>
            <input type="hidden" name="criterio" id="criterioInput" value="@criterioActual" />
        </form>
    </div>

    <!-- Criterios de Optimización (Pills) -->
    <div class="mb-4">
        <span class="text-muted me-2 small fw-semibold">Criterio de optimización:</span>
        <div class="btn-group btn-group-sm" role="group">
            <button type="button" class="btn @(criterioActual == "todos" ? "btn-dark" : "btn-outline-secondary") rounded-pill px-3 me-2" onclick="cambiarCriterio('todos')">Total viajes disponibles</button>
            <button type="button" class="btn @(criterioActual == "ganancia" ? "btn-dark" : "btn-outline-secondary") rounded-pill px-3 me-2" onclick="cambiarCriterio('ganancia')">Maximizar ganancias</button>
            <button type="button" class="btn @(criterioActual == "desvio" ? "btn-dark" : "btn-outline-secondary") rounded-pill px-3 me-2" onclick="cambiarCriterio('desvio')">Minimizar desvíos</button>
            <button type="button" class="btn @(criterioActual == "equilibrio" ? "btn-dark" : "btn-outline-secondary") rounded-pill px-3" onclick="cambiarCriterio('equilibrio')">Equilibrio</button>
        </div>
    </div>

    <!-- Tarjetas de Métricas Principales (Textos achicados y proporcionados) -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-success-subtle text-success-emphasis">
                <span class="small text-uppercase fw-bold text-success">Ganancia potencial</span>
                <h4 class="fw-bold fs-4 mb-0 mt-1">@Model.GananciaPotencial.Moneda()</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3">
                <span class="small text-uppercase text-muted fw-bold">Promedio por viaje</span>
                <h4 class="fw-bold fs-4 mb-0 mt-1">@Model.PromedioPorViaje.Moneda()</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3">
                <span class="small text-uppercase text-muted fw-bold">Ganancia por semana</span>
                <h4 class="fw-bold fs-4 mb-0 mt-1">@Model.GananciaPorSemana.Moneda()</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3">
                <span class="small text-uppercase text-muted fw-bold">Viajes analizados</span>
                <h4 class="fw-bold fs-5 mb-0 mt-1">@Model.PaquetesPosibles <span class="fs-6 text-muted fw-normal">paq. en @Model.ViajesAnalizados viajes</span></h4>
            </div>
        </div>
    </div>

    <!-- Detalle de Asignaciones y Recorridos Estimados -->
    <div class="card border-0 shadow-sm rounded-4 p-4">
        <h5 class="fw-bold mb-3">Detalle del mejor recorrido estimado</h5>
        @if (Model.MejorRecorrido != null && Model.MejorRecorrido.Any())
        {
            <div class="table-responsive">
                <table class="table align-middle table-hover small">
                    <thead class="table-light">
                        <tr>
                            <th>Fecha</th>
                            <th>Viaje recurrente</th>
                            <th>Paquetes</th>
                            <th>Peso total</th>
                            <th>Desvío total</th>
                            <th class="text-end">Ganancia estimada</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.MejorRecorrido)
                        {
                            <tr>
                                <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                                <td class="fw-semibold">@item.OrigenDestino</td>
                                <td>@item.PaquetesAsignados</td>
                               <td>@item.PesoTotalKg.Numero() kg</td>
                                <td>@item.DesvioTotalKm.Numero() km</td>
                                <td class="text-end fw-bold text-success">@item.GananciaEstimada.Moneda()</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <p class="mb-0 small">No se encontraron suficientes oportunidades compatibles para estimar un potencial en este mes.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function cambiarCriterio(criterio) {
            document.getElementById('criterioInput').value = criterio;
            // Apuntamos de forma limpia al formulario de filtros por su ID en lugar de usar forms[0]
            document.getElementById('formFiltro').submit();
        }
    </script>
}